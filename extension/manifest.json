{
  "manifest_version": 3,
  "name": "쿠팡 상품 분석기",
  "version": "1.1.5",
  "description": "쿠팡·네이버쇼핑 검색 결과와 리뷰를 수집해 가격·리뷰·인기 키워드를 분석하고 구글시트에 저장합니다.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "쿠팡 상품 분석기",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://www.coupang.com/*",
    "https://m.search.naver.com/*",
    "https://search.naver.com/*",
    "https://msearch.shopping.naver.com/*",
    "https://search.shopping.naver.com/*",
    "https://script.google.com/*",
    "https://script.googleusercontent.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.coupang.com/np/search*",
        "https://www.coupang.com/vp/products/*",
        "https://search.shopping.naver.com/*",
        "https://msearch.shopping.naver.com/*",
        "https://search.naver.com/search.naver*",
        "https://m.search.naver.com/search.naver*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
